<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Newer Windows API projection than the SDK default (.57): trim-safe -->
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
    <!-- Precomputed WinRT interop for objects handed to WinUI (needed once trimmed); level 2
         reports every class that should be partial for it -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AutoLayout</RootNamespace>
    <AssemblyName>AutoLayout</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Also for the unpackaged build: without it, dotnet publish leaves out the .pri and .xbf files -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AutoLayout.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- dotnet publish compiles to native code (needs the Visual Studio C++ build tools) and
         leaves out the unused parts of .NET and of the Windows API projection: the Store
         package is about 4 MB instead of 45, and the app starts faster and uses less memory -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Product>AutoLayout</Product>
    <Copyright>Copyright 2026 The AutoLayout authors. Licensed under the Apache License, Version 2.0.</Copyright>
  </PropertyGroup>

  <!-- Microsoft Store build: dotnet publish -p:Packaged=true (see docs/STORE.md) -->
  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- The Store installs the Windows App SDK runtime as a framework package -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\..\dist\store\</AppxPackageDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260930100" />
    <Content Include="Assets\Store\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(Packaged)' != 'true'">
    <None Remove="Package.appxmanifest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the parts used, not the Microsoft.WindowsAppSDK metapackage: it adds AI and ML
         runtimes (onnxruntime, DirectML) of about 40 MB -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoLayout.Core\AutoLayout.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\AutoLayout.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AutoLayout.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\NOTICE" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
