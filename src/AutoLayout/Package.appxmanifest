<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright 2026 The AutoLayout authors. SPDX-License-Identifier: Apache-2.0 -->
<!--
  MSIX manifest for the Microsoft Store build (dotnet publish -p:Packaged=true).
  Identity Name and Publisher, and PublisherDisplayName, are the Partner Center values
  (Product identity page; Store ID 9PDKKFCF8078): see docs/STORE.md.
  The version must match <Version> in AutoLayout.csproj and grow with each submission.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop com rescap">

  <Identity Name="ThiagoCarneiro.AutoLayout" Publisher="CN=90D2EE56-F4B5-46F3-AF21-316D5B687DE1" Version="1.0.0.0" />

  <Properties>
    <DisplayName>AutoLayout</DisplayName>
    <PublisherDisplayName>Thiago Carneiro</PublisherDisplayName>
    <Logo>Assets\Store\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="AutoLayout"
        Description="Switches the keyboard layout when external keyboards are connected."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Store\Square150x150Logo.png"
        Square44x44Logo="Assets\Store\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Store\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\Store\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- "Start with Windows": off until the user turns it on in Settings -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="AutoLayoutStartup" Enabled="false" DisplayName="AutoLayout" />
        </uap5:Extension>

        <!-- Clicks on notifications when the app is not running -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="AutoLayout.exe" Arguments="----AppNotificationActivated:" DisplayName="AutoLayout">
              <com:Class Id="A453D04E-3DE5-4669-84A7-44A9B28F789D" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="A453D04E-3DE5-4669-84A7-44A9B28F789D" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop app: needed to list keyboards, set the default layout and talk to the ThinkPad driver -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
