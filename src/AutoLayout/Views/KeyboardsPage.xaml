<Page
    x:Class="AutoLayout.Views.KeyboardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AutoLayout.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="36,24,36,36" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="Page_Keyboards" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,24" />

            <!-- What applies now, and why -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE765;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Main_InUse" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="CurrentLayoutText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReasonText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="Main_Now_Hint" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="ProblemBar" Severity="Error" IsClosable="False" Margin="0,12,0,0">
                <InfoBar.ActionButton>
                    <Button x:Name="ProblemButton" Click="OnProblemAction" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar x:Name="WaitingBar" Severity="Informational" IsClosable="False" Margin="0,12,0,0">
                <InfoBar.ActionButton>
                    <Button x:Uid="Main_SetUpButton" Click="OnSetUpWaiting" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Default layout -->
            <TextBlock x:Uid="Main_DefaultSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F4;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Main_Default_Header" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Uid="Main_Default_Description" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="DefaultCombo" x:Uid="Main_Default_Combo" Grid.Column="2" Width="280"
                              VerticalAlignment="Center" SelectionChanged="OnDefaultChanged" />
                </Grid>
            </Border>
            <HyperlinkButton x:Uid="Common_AddLayouts" Margin="0,4,0,0" Click="OnAddLayouts" />

            <!-- Keyboards -->
            <TextBlock x:Uid="Main_List_Label" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock x:Name="EmptyText" x:Uid="Main_Empty" Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="1,4,0,0" />
            <ListView x:Name="KeyboardList" x:Uid="Main_List" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="OnKeyboardClick" Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:KeyboardItem">
                        <Border Style="{StaticResource CardStyle}" Opacity="{x:Bind Opacity}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4" MaxWidth="320">
                                    <TextBlock Text="{x:Bind Layout}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Right" />
                                    <Border Background="{x:Bind StatusBackground}" CornerRadius="4" Padding="8,1" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind StatusForeground}" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind MoreLabel}" ToolTipService.ToolTip="{x:Bind MoreLabel}">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind EditLabel}" Click="OnEdit" Tag="{x:Bind Key}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind IgnoreLabel}" Click="OnToggleIgnore" Tag="{x:Bind Key}"
                                                            Visibility="{x:Bind CanIgnore}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BA;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="{x:Bind ForgetLabel}" Click="OnForget" Tag="{x:Bind Key}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
