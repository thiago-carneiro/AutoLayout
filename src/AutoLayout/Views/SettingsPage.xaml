<Page
    x:Class="AutoLayout.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="36,24,36,36">
            <TextBlock x:Uid="Page_Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- General -->
            <TextBlock x:Uid="Set_General" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" VerticalAlignment="Center" />
                    <TextBlock x:Uid="Set_Startup" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="StartupToggle" x:Uid="Set_StartupToggle" Grid.Column="2" Toggled="OnStartupToggled" />
                </Grid>
            </Border>
            <InfoBar x:Name="StartupInfo" IsClosable="False" Margin="0,4,0,0" />
            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" VerticalAlignment="Center" />
                    <TextBlock x:Uid="Set_Notify" Grid.Column="1" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="NotifyToggle" x:Uid="Set_NotifyToggle" Grid.Column="2" Toggled="OnNotifyToggled" />
                </Grid>
            </Border>

            <!-- Diagnostics -->
            <TextBlock x:Uid="Set_Diagnostics" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE9D9;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="Set_Log" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="Set_Log_Hint" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="LogToggle" x:Uid="Set_LogToggle" Grid.Column="2" Toggled="OnLogToggled" />
                    <!-- -12: the link text lines up with the text above (hyperlink buttons have 12 px of padding) -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="-12,0,0,0">
                        <HyperlinkButton x:Name="OpenLogButton" x:Uid="Set_OpenLog" Click="OnOpenLog" />
                        <HyperlinkButton x:Uid="Set_OpenFolder" Click="OnOpenFolder" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock x:Uid="Set_AboutSection" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/AutoLayout.png" Width="32" Height="32" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="App_NameText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Uid="About_Copyright" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Uid="About_License" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Uid="About_Privacy" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <!-- One link per line: in long languages a row of four links does not fit -->
                        <StackPanel Spacing="0" Margin="-12,4,0,0">
                            <HyperlinkButton x:Uid="About_ViewLicense" Click="OnViewLicense" />
                            <HyperlinkButton x:Uid="About_Credits" Click="OnViewNotice" />
                            <HyperlinkButton x:Uid="About_Website" NavigateUri="https://github.com/thiago-carneiro/AutoLayout" />
                            <HyperlinkButton x:Uid="About_Tip" NavigateUri="https://ko-fi.com/thiagopcarneiro" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
