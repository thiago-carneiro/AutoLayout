<Window
    x:Class="AutoLayout.Views.KeyboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,8,24,24" Spacing="12">
                <TextBlock x:Name="HeadingText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="IntroText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DetailsText" Style="{StaticResource SecondaryTextStyle}" />

                <TextBox x:Name="NameBox" x:Uid="Kbd_Name" MaxLength="64" Margin="0,8,0,0" />

                <StackPanel Spacing="4">
                    <ComboBox x:Name="LayoutCombo" x:Uid="Kbd_Layout" HorizontalAlignment="Stretch" SelectionChanged="OnLayoutChanged" />
                    <TextBlock x:Name="HintText" Style="{StaticResource SecondaryTextStyle}" />
                    <HyperlinkButton x:Uid="Kbd_MissingLayout" Margin="-12,0,0,0" Click="OnMissingLayout" />
                </StackPanel>

                <CheckBox x:Name="IgnoreCheck" x:Uid="Kbd_IgnoreCheck" Checked="OnIgnoreChanged" Unchecked="OnIgnoreChanged" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer, as in a Windows 11 dialog -->
        <Border Grid.Row="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NotKeyboardButton" x:Uid="Kbd_Btn_NotKeyboard" Click="OnNotKeyboard" />
                <Button x:Name="SaveButton" x:Uid="Kbd_Btn_Save" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                        MinWidth="120" Click="OnSave" />
                <Button x:Name="CancelButton" Grid.Column="3" MinWidth="120" Click="OnCancel" />
            </Grid>
        </Border>
    </Grid>
</Window>
