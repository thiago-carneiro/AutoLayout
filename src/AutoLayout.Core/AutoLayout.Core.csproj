<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Newer Windows API projection than the SDK default (.57): trim-safe -->
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
    <!-- Precomputed WinRT interop for objects handed to WinUI (needed once trimmed); level 2
         reports every class that should be partial for it -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AutoLayout.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <PathMap>$(MSBuildProjectDirectory)=AutoLayout.Core</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AutoLayout.Core.Tests" />
  </ItemGroup>
</Project>
